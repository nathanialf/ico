# =============================================================================
# IP PROTECTION — DO NOT REMOVE OR LOOSEN THESE RULES WITHOUT REVIEW
# =============================================================================
# This repository must never contain disc data, extracted assets, or any
# material owned by Sony Interactive Entertainment / Team Ico.
# The rules below ignore every common PS2 dump and extracted-asset format.
# If you need to add a real source file whose name happens to collide, prefer
# renaming the file rather than weakening the patterns.
# =============================================================================

# --- Disc images and PS2 executables ---
*.bin
*.iso
*.cue
*.chd
*.mdf
*.mds
*.nrg
*.elf
*.irx
SLUS-*
SLES-*
SLPS-*
SLPM-*
SCUS-*
SCES-*
SCPS-*
baserom/
baseelf*

# --- Build outputs that may embed disc-derived data ---
build/
*.o
*.a
*.lib
*.obj
*.map
*.ld.tmp

# --- Extracted assets (populated at build time from the user's disc) ---
assets/**
!assets/.gitkeep
!assets/README.md

# --- Disassembled / split asm (regenerated by splat from the user's ELF) ---
# Everything under asm/ is regenerated from the user's ELF. Splat 0.40.0 emits
# per-function baselines under asm/matchings/<name>/<func>.s when a subsegment
# is flipped to `c`, and under asm/nonmatchings/<TU>/<func>.s for the unmatched
# functions a TU's c-subsegment range covers (used by INCLUDE_ASM). All of
# these are reproducible from the ELF, so they stay gitignored.
asm/**
!asm/.gitkeep
!asm/README.md

# --- Audio / texture / model dumps ---
*.aifc
*.aiff
*.wav
*.adp
*.vag
*.vab
*.mid
*.seq
*.tm2
*.png.bin
*.rgba16
*.rgba32

# --- Symbol files derived from the original ELF ---
# (Symbol *names* invented by us are fine; raw vendor symbol tables are not.)
*.sym.bak

# --- Toolchain / venv / editor noise ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.idea/
.vscode/
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# --- Local config overrides ---
.env
.env.local
config/local.*
expected/

# --- m2c context output (regenerated on demand) ---
ctx.c

# --- Local toolchain blobs (Ghidra, ee-gcc, ps2toolchain source build) ---
tools/toolchain/
tools/ghidra/
tools/cc/

# --- Auto-generated linker script (regenerated by splat on every split) ---
config/ico.us.ld
config/ico.us.d
config/undefined_syms_auto.us.txt
config/undefined_funcs_auto.us.txt

# --- decomp-permuter runtime artifacts (regenerated by tools/permute_run.sh) ---
# Per-function permuter run dirs (base.c, target.s/.o, compile.sh,
# settings.toml, output-*-*/, permuter.log) and the auto-permuter activity
# log live here. Regenerated on every run; never commit.
lib/decomp-permuter/runs/
lib/decomp-permuter/auto_parked.log
# Project-root permuter settings file is generated by
# tools/gen_permuter_settings.py — keep it out of git so the path baked
# into [decompme.compilers] doesn't churn between contributors.
permuter_settings.toml

# --- Agent guidance / local-only ---
# CLAUDE.md is auto-loaded by Claude Code and is the agent's local preamble;
# kept out of the public repo to match the snap project's convention.
# decomp/MATCH.md is the public, user-facing matching prompt.
CLAUDE.md
.claude/
decomp/RUN_LOG.md
# Snapshot of asm/{cod,matchings}/ used by TU-mapping analyzers; local
# only, regenerated on demand via `tools/snapshot_asm.py`.
decomp/asm_snapshot/
# TU-mapping pipeline bulk outputs — regeneratable from the snapshot via
# tools/find_callgraph.py, find_boundaries.py, identify_tus.py. Too
# large for the IP-safety tracked-file size cap; the small summaries
# (decomp/vtables.json, decomp/unnamed_tus.md) stay tracked.
decomp/callgraph.json
decomp/boundaries.json
decomp/tu_map.json
decomp/tu_map.md
# Data symbol → owning TU map, generated by tools/build_data_tu_map.py.
# Symbol-name keyed (no bytes); 6687 entries, ~700KB, regenerable from
# baserom + tu_map.json.
decomp/data_tu_map.json
# Per-TU section boundary derivation, generated by
# tools/build_data_tu_boundaries.py from data_tu_map.json + tracked
# typed defs. Regenerated each setup; consumed by Phase 3 promotion
# tooling.
decomp/data_tu_boundaries.json
# Per-TU data sidecar .c files generated by tools/migrate_data_per_tu.py.
# Each contains the byte content of one TU's data sections in C syntax
# (unsigned char[N] = { 0xXX, ... }). The bytes are the original game's
# data — IP-sensitive — so the auto-generated form is local-only.
# Anyone who clones runs `tools/build.sh setup`, which regenerates these from
# their own baserom. As individual TUs get hand-decompiled to typed C
# definitions (parappa2-style), the typed version goes in src/<TU>.c
# without the `_data` suffix and gets committed.
src/**/*_data.c
ios/**/*_data.c
sound/**/*_data.c
isys/**/*_data.c
.cache/

# Ninja build files — manifest is auto-generated by tools/gen_ninja.py
# from config/ico.us.d on every `tools/build.sh setup`. The .ninja_log
# and .ninja_deps are runtime state.
build.ninja
.ninja_log
.ninja_deps
