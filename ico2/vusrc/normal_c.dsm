; ico2/vusrc/normal_c.dsm /* derived name */: NormalCMicroProgram, ico2000.a(normal_c.o).
; The listing has no source rows for the VU objects; the path is the one
; whose hash the base's overlay section .DVP.overlay..0x0.<hash>.11.0
; carries (tc-dvp.c vuoverlay_section_name), assembled from ico2/.
;
; Assembled by tools/cc/dvp-as (ps2dev dvp-v2.45.1) through the vu rule
; that tools/gen_ninja.py writes into build.ninja, run from ico2/.
	.global NormalCMicroProgram
NormalCMicroProgram:
	DMAret *
	MPG 0, *
;
; One of ICO's five VU1 microprograms (PAL 0x0028B380, 5856 bytes), sent to
; VU1 by mc_TransMicroCode (MicroCode.o): a DMAret tag whose VIF half
; carries MPG 0, the program, then a DMAend tag. dvp-as writes the tags,
; a new MPG every 256 instructions and the .DVP overlay tables.
;
; Re-derived from published VU0/VU1 documentation; .vutext is identical
; in the Aug-6-2001 prototype, USA and PAL retail. The labels are the DVP
; assembler's own, from the PAL listing's .vutext symbol table (spelled
; _$NAME there, the copy dvp-as makes), each at the listing's address.
;
; Program-3 entry-stub dispatch (continuous from here through 0x18E8).
	nop                              b SET_GSREGISTER                       ; 0x17C0 - entry -> SET_GSREGISTER
	nop                              nop                                    ; delay slot
	nop                              b SET_UVOFFSET                         ; 0x17D0 - entry -> SET_UVOFFSET
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x17E0 - reserved slot
	nop                              nop                                    ; 0x17E8 - reserved slot
	nop                              nop                                    ; 0x17F0 - reserved slot
	nop                              nop                                    ; 0x17F8 - reserved slot
	nop                              b SET_FONT_OFFSET                      ; 0x1800 - entry -> SET_FONT_OFFSET
	nop                              nop                                    ; delay slot
	nop                              b START_DEBUG_FONT                     ; 0x1810 - entry -> START_DEBUG_FONT
	nop                              nop                                    ; delay slot
	nop                              b SPACE_DEBUG_FONT                     ; 0x1820 - entry -> SPACE_DEBUG_FONT
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x1830 - reserved slot
	nop                              nop                                    ; 0x1838 - reserved slot
	nop                              b SET_NORMAL_MATRIX                    ; 0x1840 - entry -> SET_NORMAL_MATRIX
	nop                              nop                                    ; delay slot
	nop                              b SET_NORMAL_LIGHT                     ; 0x1850 - entry -> SET_NORMAL_LIGHT
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x1860 - reserved slot
	nop                              nop                                    ; 0x1868 - reserved slot
	nop                              nop                                    ; 0x1870 - reserved slot
	nop                              nop                                    ; 0x1878 - reserved slot
	nop                              nop                                    ; 0x1880 - reserved slot
	nop                              nop                                    ; 0x1888 - reserved slot
	nop                              nop                                    ; 0x1890 - reserved slot
	nop                              nop                                    ; 0x1898 - reserved slot
	nop                              nop                                    ; 0x18A0 - reserved slot
	nop                              nop                                    ; 0x18A8 - reserved slot
	nop                              nop                                    ; 0x18B0 - reserved slot
	nop                              nop                                    ; 0x18B8 - reserved slot
	nop                              b BEGIN_NORMAL_C                       ; 0x18C0 - entry -> BEGIN_NORMAL_C
	nop                              nop                                    ; delay slot
	nop                              b BEGIN_NORMAL_C_NOCLIP                ; 0x18D0 - entry -> BEGIN_NORMAL_C_NOCLIP
	nop                              nop                                    ; delay slot
	nop                              b BEGIN_SCISSOR_C                             ; 0x18E0 - entry -> sub_2BB0  (far target)
	nop                              nop                                    ; delay slot

; =======================================================================
; PROGRAM 3 SUBROUTINE BODIES.  Most are direct clones of program 1/2
; routines at new VRAM offsets; the new ones (SET_NORMAL_MATRIX / SET_NORMAL_LIGHT /
; BEGIN_NORMAL_C / START_NORMAL_C) handle bulk-data uploads and another skinned
; transform variant.
; =======================================================================

; -----------------------------------------------------------------------
; SET_GSREGISTER - copy-with-count + xgkick + END (clone of SET_GSREGISTER (mesh)).
; -----------------------------------------------------------------------
SET_GSREGISTER:
	nop                              xtop vi12
	nop                              ilwr.x vi10, (vi12)
	nop                              iaddiu vi07, vi12, 191
	nop                              iaddiu vi09, vi07, 0
	nop                              lqi.xyzw vf29, (vi12++)
	nop                              iaddiu vi13, vi00, 32767
	nop                              iand vi10, vi13, vi10
	nop                              sqi.xyzw vf29, (vi09++)
SET_GSREGISTER_LOOP:
	nop                              lqi.xyzw vf28, (vi12++)
	nop                              iaddi vi10, vi10, -1
	nop                              nop
	nop                              ibne vi10, vi00, SET_GSREGISTER_LOOP
	nop                              sqi.xyzw vf28, (vi09++)                ; (branch delay slot)
	nop                              nop
	nop                              xgkick vi07
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; SET_UVOFFSET - mem[2].xy patch (clone of SET_UVOFFSET (mesh)).
; -----------------------------------------------------------------------
SET_UVOFFSET:
	nop                              xtop vi01
	nop                              lq.xyzw vf30, 2(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              move.xy vf30, vf31
	nop                              sq.xyzw vf30, 2(vi00)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; SET_FONT_OFFSET - 4-quad matrix upload to mem[256] (clone of SET_FONT_OFFSET (mesh)).
; -----------------------------------------------------------------------
SET_FONT_OFFSET:
	nop                              xtop vi12
	nop                              iaddiu vi13, vi00, 256
	nop                              lqi.xyzw vf18, (vi12++)
	nop                              lqi.xyzw vf19, (vi12++)
	nop                              lqi.xyzw vf16, (vi12++)
	nop                              lqi.xyzw vf17, (vi12++)
	nop                              sqi.xyzw vf18, (vi13++)
	nop                              sqi.xyzw vf19, (vi13++)
	nop                              sqi.xyzw vf16, (vi13++)
	nop                              sqi.xyzw vf17, (vi13++)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; BEGIN_DEBUG_FONT - shared E-bit-only stub (clone of BEGIN_DEBUG_FONT (mesh)).
; -----------------------------------------------------------------------
BEGIN_DEBUG_FONT:
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; START_DEBUG_FONT - palette-indexed vertex transform (clone of START_DEBUG_FONT (mesh)).
; Falls through into SPACE_DEBUG_FONT for terminator.
; -----------------------------------------------------------------------
START_DEBUG_FONT:
	nop                              xtop vi12
	nop                              iaddiu vi11, vi12, 1
	nop                              ilwr.x vi10, (vi12)
	nop                              lq.xyzw vf29, 0(vi12)
	nop                              iaddiu vi13, vi00, 32767
	nop                              iaddiu vi07, vi12, 191
	nop                              iaddiu vi09, vi07, 0
	nop                              sqi.xyzw vf29, (vi09++)
	nop                              iand vi10, vi13, vi10
	nop                              iaddiu vi13, vi00, 1
	nop                              lq.xyzw vf09, 0(vi11)
	nop                              ilwr.w vi14, (vi11)
	nop                              nop
	nop                              iand vi15, vi13, vi14

LOOP_DEBUG_FONT:
	add.xy vf09, vf09, vf16          lq.xyzw vf20, 256(vi15)
	nop                              move.w vf09, vf00
	nop                              iaddiu vi11, vi11, 1
	nop                              ilwr.w vi14, (vi11)
	nop                              iaddi vi10, vi10, -1
	ftoi4.xyzw vf10, vf09            sqi.xyzw vf20, (vi09++)
	nop                              lq.xyzw vf09, 0(vi11)
	nop                              iand vi15, vi13, vi14
	nop                              ibne vi10, vi00, LOOP_DEBUG_FONT
	nop                              sqi.xyzw vf10, (vi09++)                ; (branch delay slot)

	nop                              nop
	nop                              xgkick vi07
	nop                              nop                                    ; falls through into SPACE_DEBUG_FONT

; -----------------------------------------------------------------------
; SPACE_DEBUG_FONT - final palette-step + `b BEGIN_DEBUG_FONT` (clone of SPACE_DEBUG_FONT (mesh)).
; -----------------------------------------------------------------------
SPACE_DEBUG_FONT:
	add.xy vf16, vf16, vf17          nop
	nop                              b BEGIN_DEBUG_FONT
	nop                              nop                                    ; (branch delay slot)

; -----------------------------------------------------------------------
; SET_NORMAL_MATRIX - bulk 13-quad copy from VIF input to mem[16..27], plus a
; final `lq mem[3]; sq mem[37]` constant-copy.
;
; The first four quads land in vf01..vf04 (then stored to mem[16..19]);
; the next nine quads all stream through vf31 (each lqi -> sq pair),
; landing in mem[20..27].  At the tail, a fixed `lq vf31, 3(vi00)`
; reads mem[3] and writes it to mem[37].
; -----------------------------------------------------------------------
SET_NORMAL_MATRIX:
	nop                              xtop vi01
	nop                              lqi.xyzw vf01, (vi01++)
	nop                              sq.xyzw vf01, 16(vi00)
	nop                              lqi.xyzw vf02, (vi01++)
	nop                              sq.xyzw vf02, 17(vi00)
	nop                              lqi.xyzw vf03, (vi01++)
	nop                              sq.xyzw vf03, 18(vi00)
	nop                              lqi.xyzw vf04, (vi01++)
	nop                              sq.xyzw vf04, 19(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 20(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 21(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 22(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 23(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 24(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 25(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 26(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 27(vi00)
	nop                              lq.xyzw vf31, 3(vi00)                  ; vf31 = mem[3]
	nop                              sq.xyzw vf31, 37(vi00)                 ; mem[37] = vf31
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; SET_NORMAL_LIGHT - bulk 8-quad copy from VIF input via vf31 to mem[28..35].
;
; Tail-half of SET_NORMAL_MATRIX's upload pattern; each lqi/sq pair streams
; one quad through vf31 to a fixed mem slot.
; -----------------------------------------------------------------------
SET_NORMAL_LIGHT:
	nop                              xtop vi01
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 28(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 29(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 30(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 31(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 32(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 33(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 34(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 35(vi00)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; BEGIN_NORMAL_C - I-register setup + small prologue.  Same I-bit pattern
; as SET_MESH_MATRIX (mesh) (two `pad[I]` bundles loading 0x4B7FFFFE and 0x457FF000),
; consumed by `addi.w/.xy vf14, vf00`.  Falls through into START_NORMAL_C.
; -----------------------------------------------------------------------
BEGIN_NORMAL_C:
	nop                              loi 0x4b7ffffe                         ; pad[I] + I = 0x4B7FFFFE
	addi.w vf14, vf00, i             move.xyzw vf13, vf00                   ; vf14.w = I; vf13 = 0
	nop                              loi 0x457ff000                         ; pad[I] + I = 0x457FF000 (= 4094.0f)
	addi.xy vf14, vf00, i            nop                                    ; vf14.xy = I
	nop                              lq.xyzw vf23, 2(vi00)                  ; vf23 = mem[2]
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; START_NORMAL_C - program-3 skinned vertex transform (variant 7).
;
; Restructured variant of START_MESH_LIGHT (mesh) / START_MESH_LIGHT_SPEC (mesh):
;   * Output base is +192 (not +252).
;   * `move.z vf23, vf00` patches vf23.z = 0 mid-setup (mem[2].z mask).
;   * `add.xyz vf21, vf17, vf23` accumulator uses .xyz lanes (not the
;     usual .xy) plus a sub.w guard `sub.w vf00, vf17, vf00`.
;   * `mulw.xyzw vf15, vf24, vf00` / `mulw.xyzw vf28, vf29, vf00` in
;     the loop body (w-broadcast scaled by vf00.w=1).
;   * Two `ibne vi04, vi00, LOOP_NORMAL_C` exit-paths (post-front-face and
;     post-back-face) each kicked by `xgkick vi01` and `b BEGIN_NORMAL_C`
;     back into BEGIN_NORMAL_C's pre-END E-bit.
;   * Uses `ibeq vi15, vi00, CONT_NORMAL_C` to skip a reset of vi05 to 3.
; -----------------------------------------------------------------------
START_NORMAL_C:
	nop                              xtop vi13
	nop                              iaddiu vi14, vi00, 32767
	nop                              iaddiu vi02, vi13, 1
	nop                              ilwr.x vi04, (vi13)
	nop                              lq.xyzw vf29, 0(vi13)
	nop                              iand vi04, vi14, vi04
	nop                              iaddiu vi01, vi13, 192                 ; output base = vi13 + 192
	nop                              sq.xyzw vf29, 0(vi01)
	nop                              iaddi vi14, vi14, 1
	nop                              iaddiu vi03, vi01, 1
	nop                              mfir.w vf19, vi00
	nop                              mfir.w vf20, vi14
	nop                              lq.xyzw vf15, 0(vi02)
	sub.w       vf21, vf21, vf21     lq.xyzw vf17, 1(vi02)
	nop                              lq.xyzw vf18, 2(vi02)
	nop                              move.z vf23, vf00                      ; vf23.z = 0 (lane mask)
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     nop
	sub.w       vf00, vf17, vf00     lq.xyzw vf15, 3(vi02)
	add.xyz     vf21, vf17, vf23     iaddiu vi07, vi00, 208                 ; vi07 = 0xD0 clip mask
	nop                              nop
	nop                              div q, vf00w, vf28w
	nop                              fsand vi15, 0x2
	nop                              nop
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop

LOOP_NORMAL_C:
	maddaz.xyzw acc, vf03, vf15z     lq.xyzw vf17, 4(vi02)
	maddw.xyzw vf29, vf04, vf00w     ibeq vi15, vi00, CONT_NORMAL_C
	nop                              iaddi vi04, vi04, -1                   ; (delay slot)
	nop                              iaddiu vi05, vi00, 3
CONT_NORMAL_C:
	mulq.xyz vf28, vf28, q           iaddi vi05, vi05, -1
	mulq.xyz vf21, vf21, q           iaddiu vi02, vi02, 3
	ftoi0.xyzw  vf22, vf18           lq.xyzw vf24, 3(vi02)
	sub.w       vf00, vf17, vf00     div q, vf00w, vf29w
	sub.xyw     vf00, vf13, vf28     lq.xyzw vf18, 2(vi02)
	sub.xyw     vf00, vf28, vf14     sq.xyzw vf21, 0(vi03)
	ftoi4.xyz   vf19, vf28           sq.xyzw vf22, 1(vi03)
	ftoi4.xyz   vf20, vf28           fsand vi15, 0x2
	mulw.xyzw vf15, vf24, vf00w      fmand vi14, vi07
	mulw.xyzw vf28, vf29, vf00w      fmand vi14, vi14
	add.xyz     vf21, vf17, vf23     ibne vi14, vi07, CLIP_NORMAL_C
	nop                              iaddiu vi03, vi03, 3
	nop                              ibgtz vi05, CLIP_NORMAL_C_SET
	nop                              nop                                    ; (delay slot)
	mulax.xyzw acc, vf01, vf15x      ibne vi04, vi00, LOOP_NORMAL_C
	madday.xyzw acc, vf02, vf15y     sq.xyzw vf19, -1(vi03)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C                       ; -> BEGIN_NORMAL_C's E-bit
	nop                              nop                                    ; (branch delay slot)
CLIP_NORMAL_C:
	nop                              iaddiu vi05, vi00, 3
CLIP_NORMAL_C_SET:
	mulax.xyzw acc, vf01, vf15x      ibne vi04, vi00, LOOP_NORMAL_C
	madday.xyzw acc, vf02, vf15y     sq.xyzw vf20, -1(vi03)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C                       ; -> BEGIN_NORMAL_C's E-bit
	nop                              nop                                    ; (branch delay slot)

; -----------------------------------------------------------------------
; BEGIN_NORMAL_C_NOCLIP - second I-register setup (clone of BEGIN_NORMAL_C), but only
; covers the first 4 bundles in this chunk; the routine extends past
; 0x1F00 into the next batch.  Stopping here at the natural seam.
; -----------------------------------------------------------------------
BEGIN_NORMAL_C_NOCLIP:
	nop                              loi 0x4b7ffffe                         ; pad[I] + I = 0x4B7FFFFE
	addi.w vf14, vf00, i             move.xyzw vf13, vf00
	nop                              loi 0x457ff000                         ; pad[I] + I = 0x457FF000
	addi.xy vf14, vf00, i            nop
	nop                              lq.xyzw vf23, 2(vi00)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot
; --- BEGIN_NORMAL_C_NOCLIP transform body (0x1ED8..0x2078) ---
; Reached directly when the EE sets VU0_TPC=0x1ED8 (or a wrapper jumps
; here).  The routine processes a vertex batch and at the loop tail
; branches `b L_06F8` back into BEGIN_NORMAL_C_NOCLIP's I-setup tail, which then
; hits the 0x1EC8 E-bit to terminate.  Same exit-via-branch-into-tail
; pattern as START_NORMAL_C / BEGIN_NORMAL_C in this program.
START_NORMAL_C_NOCLIP:
	nop                              xtop vi13
	nop                              iaddiu vi14, vi00, 32767
	nop                              iaddiu vi02, vi13, 1
	nop                              ilwr.x vi04, (vi13)
	nop                              lq.xyzw vf29, 0(vi13)
	nop                              iand vi04, vi14, vi04
	nop                              iaddiu vi01, vi13, 192
	nop                              sq.xyzw vf29, 0(vi01)
	nop                              iaddi vi14, vi14, 1
	nop                              iaddiu vi03, vi01, 1
	nop                              mfir.w vf19, vi00
	nop                              mfir.w vf20, vi14
	nop                              lq.xyzw vf15, 0(vi02)
	sub.w       vf21, vf21, vf21     lq.xyzw vf17, 1(vi02)
	nop                              lq.xyzw vf18, 2(vi02)
	nop                              move.z vf23, vf00
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     nop
	sub.w       vf00, vf17, vf00     lq.xyzw vf15, 3(vi02)
	nop                              iaddiu vi07, vi00, 208
	nop                              nop
	nop                              div q, vf00w, vf28w
	add.xyz     vf21, vf17, vf23     fsand vi15, 0x2
	nop                              nop
	mulax.xyzw acc, vf01, vf15x      nop
LOOP_NORMAL_C_NOCLIP:
	madday.xyzw acc, vf02, vf15y     lq.xyzw vf17, 4(vi02)

	maddaz.xyzw acc, vf03, vf15z     ibeq vi15, vi00, CONT_NORMAL_C_NOCLIP
	maddw.xyzw vf29, vf04, vf00w     iaddiu vi02, vi02, 3
	nop                              iaddiu vi05, vi00, 3
CONT_NORMAL_C_NOCLIP:
	mulq.xyz vf28, vf28, q           iaddi vi05, vi05, -1
	mulq.xyz vf21, vf21, q           lq.xyzw vf24, 3(vi02)
	ftoi0.xyzw  vf22, vf18           iaddi vi04, vi04, -1
	ftoi4.xyz   vf19, vf28           div q, vf00w, vf29w
	sub.w       vf00, vf17, vf00     lq.xyzw vf18, 2(vi02)
	ftoi4.xyz   vf20, vf28           sqi.xyzw vf21, (vi03++)
	mulw.xyzw vf15, vf24, vf00w      sqi.xyzw vf22, (vi03++)
	mulw.xyzw vf28, vf29, vf00w      ibgtz vi05, CLIP_NORMAL_C_NOCLIP_SET
	nop                              fsand vi15, 0x2
NOCLIP_NORMAL_C_NOCLIP_SET:
	add.xyz     vf21, vf17, vf23     ibne vi04, vi00, LOOP_NORMAL_C_NOCLIP
	mulax.xyzw acc, vf01, vf15x      sqi.xyzw vf19, (vi03++)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C_NOCLIP                               ; -> BEGIN_NORMAL_C_NOCLIP's E-bit
	nop                              nop                                    ; (branch delay slot)
CLIP_NORMAL_C_NOCLIP_SET:
	add.xyz     vf21, vf17, vf23     ibne vi04, vi00, LOOP_NORMAL_C_NOCLIP
	mulax.xyzw acc, vf01, vf15x      sqi.xyzw vf20, (vi03++)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C_NOCLIP                               ; -> BEGIN_NORMAL_C_NOCLIP's E-bit
	nop                              nop                                    ; (branch delay slot)

; -----------------------------------------------------------------------
; SCISSOR_COMMON - hierarchical LOD mesh subdivision driver.
;
; Top-level dispatcher that walks 6 LOD tiers, each running the same
; per-vertex transform inner loop with different bone-count and
; mip-step parameters.  The inner subroutines are:
;   CLIP_INTER - per-vertex blend + lit-color quantize (called via
;            `bal vi02` from every tier's inner loop).
;   SAVE_LAST_LOOP - 3-quad output flush (called via `bal vi02` at each
;            tier's end).
;   END_ALL - `jr vi15` early-out (taken when vi11 hasn't accumulated
;            anything).
;   INTERPOLATE - front/back-face refinement (called via `bal vi01`).
;   LOOP_ROT_END - perspective-divide + clip-test continuation of INTERPOLATE.
;
; Setup (0x2080..0x2168):
;   - vi08 = mem[104] (input vertex buffer base)
;   - Initial L_08D8 store-pattern: copies vf22 to slots {0,9},
;     vf23 to {3}, vf24 to {6}, then re-loads through stored vi03
;     offsets and applies vf17 .xy fixups before saving back.
;   - Re-loads three quads from vi07-relative slots and integerizes
;     via itof0 (no - actually IEEE float "int-to-float" cast).
;
; Tier loop body (repeats 6 times with different constants):
;   - vi05 = work-quad-count (2048 / 1024 / 512 / 256 / 128 / 64)
;   - vi06 = mip-step          (32 / 16 / 8 / 4 / 2 / 1)
;   - vi07 = bone-row-index    (2 / 2 / 1 / 1 / 0 / 0)
;   - vi10 = inner-loop counter (3) ; vi11 = output cursor (0 initial)
;   - 3 lqi prefetches (vf21/22/23) from vi08-stream
;   - Inner loop @ L_2XXX:  `bal CLIP_INTER` ; isubiu vi10 ; ibne back
;   - `iaddiu vi08, 164 or 104` (swap input buffer)
;   - `bal SAVE_LAST_LOOP` (flush output)
;   - `ibeq vi11, END_ALL` (early-out if nothing accumulated)
;   - subw.x / addw.x toggles the sign of vf30.x for the next tier
;
; Final block (0x2540..0x2568):
;   `bal vi01, sub_2818` - jumps to a save-context subroutine that
;   reads vi10=vi11 and lqi 3 quads, then xgkicks vi02 for output.
;
; END_ALL: `jr vi15` - return-to-caller stub used by all early-out
;   `ibeq vi11, END_ALL` paths.
;
; SAVE_LAST_LOOP: 3-quad flush subroutine.  Reads 3 quads from vi08-relative
;   slots, sqi to vi09-stream, then `jr vi02` returns to caller.
;
; CLIP_INTER: per-vertex blend + lit-color subroutine.  3 add.xyzw
;   bundles produce vf17/vf18/vf19 = vf31 + vfXX (lit-additive blend),
;   then two `.word`-emitted flag-bits-set FMACs at 0x25D8/0x25E0
;   (op6=0x3F .xyz, fd=7 fs=17/21 ft=17/21 - likely partial-mask
;   accumulator collapse), then fcget polls clip flags.  Based on
;   the masked flags, branches between three slot-store paths:
;     - CO_NEXT_IN: 3 sqi (vf25/26/27 only).
;     - CUR_IN -> 6 sqi (vf17..vf19 + vf25..vf27) + iaddiu vi11+=2.
;     - CI_NEXT_IN: 3 sqi (vf17..vf19) + iaddiu vi11+=1.
;   All converge at CLIP_INTER_END: `jr vi02` return.
;
; INTERPOLATE: refinement subroutine.  Computes `vf25 = mulx(vf17, vf30)`
;   and `vf26 = mulx(vf21, vf30)`, subtracts to get error vectors,
;   then loop-walks with `mr32` rotate-by-32 to swizzle lanes until
;   the per-bone error counter vi12 hits zero, dropping into LOOP_ROT_END.
;
; LOOP_ROT_END: perspective-divide path.  `div Q = vf25.x/vf27.x` then
;   `addq.x vf29` + `abs.x vf29` yields a magnitude.  Three
;   sub.xyzw bundles produce vf25/vf26/vf27 = (vf21..vf23)-(vf17..vf19),
;   each mulx'd by vf29, and finally added into vf17..vf19.  The
;   routine falls through past 0x27F8 into more code at 0x2800+.
; -----------------------------------------------------------------------
SCISSOR_COMMON:
	nop                              iaddiu vi08, vi00, 104                 ; vi08 = mem[104] (input vtx base)
	nop                              sq.xyzw vf22, 0(vi08)                  ; mem[104+0] = vf22
	nop                              sq.xyzw vf22, 9(vi08)                  ; mem[104+9] = vf22 (mirror)
	nop                              sq.xyzw vf23, 3(vi08)                  ; mem[104+3] = vf23
	nop                              iaddiu vi09, vi00, 164                 ; vi09 = mem[164] (output base)
	nop                              sq.xyzw vf24, 6(vi08)                  ; mem[104+6] = vf24
	nop                              lq.xyzw vf22, -8(vi03)                 ; reload from vi03 stream
	add.xy vf22, vf22, vf17          lq.xyzw vf23, -5(vi03)
	add.xy vf23, vf23, vf17          lq.xyzw vf24, -2(vi03)
	add.xy vf24, vf24, vf17          nop
	nop                              sq.xyzw vf22, 2(vi08)
	nop                              sq.xyzw vf22, 11(vi08)
	nop                              sq.xyzw vf23, 5(vi08)
	nop                              sq.xyzw vf24, 8(vi08)
	nop                              lq.xyzw vf22, -5(vi07)
	itof0.xyzw vf22, vf22            lq.xyzw vf23, -2(vi07)
	itof0.xyzw vf23, vf23            lq.xyzw vf24, 1(vi07)
	itof0.xyzw vf24, vf24            nop
	nop                              sq.xyzw vf22, 1(vi08)
	nop                              sq.xyzw vf22, 10(vi08)
	nop                              sq.xyzw vf23, 4(vi08)
	nop                              sq.xyzw vf24, 7(vi08)

; --- LOD tier 1 ---
ZMINUS:
	nop                              iaddiu vi05, vi00, 2048
	nop                              iaddiu vi06, vi00, 32
	nop                              iaddiu vi07, vi00, 2
	nop                              iaddiu vi10, vi00, 3
	nop                              iaddiu vi11, vi00, 0
	subw.x vf30, vf00, vf00w         lqi.xyzw vf21, (vi08++)
	nop                              lqi.xyzw vf22, (vi08++)
	nop                              lqi.xyzw vf23, (vi08++)
LOOP_ZM:
	nop                              bal vi02, CLIP_INTER
	nop                              nop
	nop                              isubiu vi10, vi10, 1
	nop                              nop
	nop                              ibne vi10, vi00, LOOP_ZM
	nop                              nop
	nop                              iaddiu vi08, vi00, 164
	nop                              bal vi02, SAVE_LAST_LOOP
	nop                              nop
	nop[d]                           nop                                    ; pad with M-bit flag (bit 28)
	nop                              ibeq vi11, vi00, END_ALL
	nop                              nop

; --- LOD tier 2 ---
ZPLUS:
	nop                              iaddiu vi05, vi00, 1024
	nop                              iaddiu vi06, vi00, 16
	nop                              iaddiu vi07, vi00, 2
	nop                              iaddiu vi08, vi00, 164
	nop                              iaddiu vi09, vi00, 104
	nop                              iadd vi10, vi00, vi11                  ; vi10 = previous tier's vi11
	nop                              iaddiu vi11, vi00, 0
	addw.x vf30, vf00, vf00w         nop
	nop                              lqi.xyzw vf21, (vi08++)
	nop                              lqi.xyzw vf22, (vi08++)
	nop                              lqi.xyzw vf23, (vi08++)
LOOP_ZP:
	nop                              bal vi02, CLIP_INTER
	nop                              nop
	nop                              isubiu vi10, vi10, 1
	nop                              nop
	nop                              ibne vi10, vi00, LOOP_ZP
	nop                              nop
	nop                              iaddiu vi08, vi00, 104
	nop                              bal vi02, SAVE_LAST_LOOP
	nop                              nop
	nop                              ibeq vi11, vi00, END_ALL
	nop                              nop

; --- LOD tier 3 ---
XMINUS:
	nop                              iaddiu vi05, vi00, 128
	nop                              iaddiu vi06, vi00, 2
	nop                              iaddiu vi07, vi00, 0
	nop                              iaddiu vi08, vi00, 104
	nop                              iaddiu vi09, vi00, 164
	nop                              iadd vi10, vi00, vi11
	nop                              iaddiu vi11, vi00, 0
	subw.x vf30, vf00, vf00w         nop
	nop                              lqi.xyzw vf21, (vi08++)
	nop                              lqi.xyzw vf22, (vi08++)
	nop                              lqi.xyzw vf23, (vi08++)
LOOP_XM:
	nop                              bal vi02, CLIP_INTER
	nop                              nop
	nop                              isubiu vi10, vi10, 1
	nop                              nop
	nop                              ibne vi10, vi00, LOOP_XM
	nop                              nop
	nop                              iaddiu vi08, vi00, 164
	nop                              bal vi02, SAVE_LAST_LOOP
	nop                              nop
	nop                              ibeq vi11, vi00, END_ALL
	nop                              nop

; --- LOD tier 4 ---
XPLUS:
	nop                              iaddiu vi05, vi00, 64
	nop                              iaddiu vi06, vi00, 1
	nop                              iaddiu vi07, vi00, 0
	nop                              iaddiu vi08, vi00, 164
	nop                              iaddiu vi09, vi00, 104
	nop                              iadd vi10, vi00, vi11
	nop                              iaddiu vi11, vi00, 0
	addw.x vf30, vf00, vf00w         nop
	nop                              lqi.xyzw vf21, (vi08++)
	nop                              lqi.xyzw vf22, (vi08++)
	nop                              lqi.xyzw vf23, (vi08++)
LOOP_XP:
	nop                              bal vi02, CLIP_INTER
	nop                              nop
	nop                              isubiu vi10, vi10, 1
	nop                              nop
	nop                              ibne vi10, vi00, LOOP_XP
	nop                              nop
	nop                              iaddiu vi08, vi00, 104
	nop                              bal vi02, SAVE_LAST_LOOP
	nop                              nop
	nop                              ibeq vi11, vi00, END_ALL
	nop                              nop

; --- LOD tier 5 ---
YMINUS:
	nop                              iaddiu vi05, vi00, 512
	nop                              iaddiu vi06, vi00, 8
	nop                              iaddiu vi07, vi00, 1
	nop                              iaddiu vi08, vi00, 104
	nop                              iaddiu vi09, vi00, 164
	nop                              iadd vi10, vi00, vi11
	nop                              iaddiu vi11, vi00, 0
	subw.x vf30, vf00, vf00w         nop
	nop                              lqi.xyzw vf21, (vi08++)
	nop                              lqi.xyzw vf22, (vi08++)
	nop                              lqi.xyzw vf23, (vi08++)
LOOP_YM:
	nop                              bal vi02, CLIP_INTER
	nop                              nop
	nop                              isubiu vi10, vi10, 1
	nop                              nop
	nop                              ibne vi10, vi00, LOOP_YM
	nop                              nop
	nop                              iaddiu vi08, vi00, 164
	nop                              bal vi02, SAVE_LAST_LOOP
	nop                              nop
	nop                              ibeq vi11, vi00, END_ALL
	nop                              nop

; --- LOD tier 6 ---
YPLUS:
	nop                              iaddiu vi05, vi00, 256
	nop                              iaddiu vi06, vi00, 4
	nop                              iaddiu vi07, vi00, 1
	nop                              iaddiu vi08, vi00, 164
	nop                              iaddiu vi09, vi00, 104
	nop                              iadd vi10, vi00, vi11
	nop                              iaddiu vi11, vi00, 0
	addw.x vf30, vf00, vf00w         nop
	nop                              lqi.xyzw vf21, (vi08++)
	nop                              lqi.xyzw vf22, (vi08++)
	nop                              lqi.xyzw vf23, (vi08++)
LOOP_YP:
	nop                              bal vi02, CLIP_INTER
	nop                              nop
	nop                              isubiu vi10, vi10, 1
	nop                              nop
	nop                              ibne vi10, vi00, LOOP_YP
	nop                              nop
	nop                              iaddiu vi08, vi00, 104
	nop                              bal vi02, SAVE_LAST_LOOP
	nop                              nop
	nop                              ibeq vi11, vi00, END_ALL
	nop                              nop

; --- Final consolidation block: call save-context routine at sub_2818 ---
	nop                              iaddiu vi08, vi00, 104
	nop                              iaddiu vi09, vi00, 164
	nop                              iadd vi10, vi00, vi11
	nop                              iaddiu vi11, vi00, 0
	nop                              bal vi01, DrawScissorPolygon                     ; call save-context routine
	nop                              nop

; -----------------------------------------------------------------------
; END_ALL - shared early-out return stub.  `jr vi15` jumps back to
; whatever caller set vi15 to (typically the EE-level VCALLMS).
; -----------------------------------------------------------------------
END_ALL:
	nop                              jr vi15
	nop                              nop

; -----------------------------------------------------------------------
; SAVE_LAST_LOOP - 3-quad flush subroutine.  Loads 3 quads from mem[vi08+0..2]
; and stores them post-increment into the vi09 output stream.
; Returns via `jr vi02`.
; -----------------------------------------------------------------------
SAVE_LAST_LOOP:
	nop                              lq.xyzw vf21, 0(vi08)
	nop                              lq.xyzw vf22, 1(vi08)
	nop                              lq.xyzw vf23, 2(vi08)
	nop                              sqi.xyzw vf21, (vi09++)
	nop                              sqi.xyzw vf22, (vi09++)
	nop                              sqi.xyzw vf23, (vi09++)
	nop                              jr vi02
	nop                              nop

; -----------------------------------------------------------------------
; CLIP_INTER - per-vertex blend + clip-flag-driven output selection.
;
; First three FMACs add vf31 (a tier-shared base vertex) to the
; lqi'd vf21/vf22/vf23, producing vf17/vf18/vf19 as lit + position
; pairs (with output prefetch via lqi vf21/22/23 next-iter).
; Two flag-bits-set FMACs at 0x25D8/0x25E0 do partial-mask masked
; accumulator collapses (emitted as `.word`).
; fcget polls clip flags into vi01; two `iand`/`ibeq` tests select
; between three storage paths (front-face-only / both / back-face-only).
; -----------------------------------------------------------------------
CLIP_INTER:
	add.xyzw vf17, vf31, vf21        lqi.xyzw vf21, (vi08++)
	add.xyzw vf18, vf31, vf22        lqi.xyzw vf22, (vi08++)
	add.xyzw vf19, vf31, vf23        lqi.xyzw vf23, (vi08++)
	clipw.xyz vf17, vf17w            nop                                    ; upper op6=0x3F .xyz fd=7 fs=17 ft=17 (FD-dispatch)
	clipw.xyz vf21, vf21w            nop                                    ; upper op6=0x3F .xyz fd=7 fs=21 ft=21 (FD-dispatch)
	nop                              nop
	nop                              nop
	nop                              nop
	nop                              fcget vi01                             ; vi01 = clip flag bits
	nop                              iand vi04, vi01, vi05                  ; vi04 = vi01 & tier-mask
	nop                              nop
	nop                              ibeq vi04, vi00, CUR_IN
	nop                              nop
CUR_OUT:
	nop                              iand vi04, vi01, vi06                  ; vi04 = vi01 & mip-mask
	nop                              nop
	nop                              ibeq vi04, vi00, CO_NEXT_IN
	nop                              nop
CO_NEXT_OUT:
	nop                              b CLIP_INTER_END
	nop                              nop
CO_NEXT_IN:
	nop                              bal vi01, INTERPOLATE                  ; refine via subroutine
	nop                              nop                                    ; (delay slot)
	nop                              sqi.xyzw vf25, (vi09++)                ; store refined vf25/26/27
	nop                              sqi.xyzw vf26, (vi09++)
	nop                              sqi.xyzw vf27, (vi09++)
	nop                              iaddiu vi11, vi11, 1
	nop                              b CLIP_INTER_END
	nop                              nop
CUR_IN:
	nop                              iand vi04, vi01, vi06
	nop                              nop
	nop                              ibeq vi04, vi00, CI_NEXT_IN
	nop                              nop
CI_NEXT_OUT:
	nop                              bal vi01, INTERPOLATE                  ; refine (both-path variant)
	nop                              nop                                    ; (delay slot)
	nop                              sqi.xyzw vf17, (vi09++)                ; store base vf17/18/19
	nop                              sqi.xyzw vf18, (vi09++)
	nop                              sqi.xyzw vf19, (vi09++)
	nop                              sqi.xyzw vf25, (vi09++)                ; + refined vf25/26/27
	nop                              sqi.xyzw vf26, (vi09++)
	nop                              sqi.xyzw vf27, (vi09++)
	nop                              iaddiu vi11, vi11, 2
	nop                              b CLIP_INTER_END
	nop                              nop
CI_NEXT_IN:
	nop                              sqi.xyzw vf17, (vi09++)                ; store base vf17/18/19 only
	nop                              sqi.xyzw vf18, (vi09++)
	nop                              sqi.xyzw vf19, (vi09++)
	nop                              iaddiu vi11, vi11, 1
CLIP_INTER_END:
	nop                              jr vi02                                ; return
	nop                              nop

; -----------------------------------------------------------------------
; INTERPOLATE - per-bone refinement subroutine.
;
; Computes mulx-w broadcasts of vf17/vf21 by vf30, then subw.xyzw
; produces vf25/vf26 = vfXX - (vfXX*vf30.w) error vectors.  vi12 =
; vi07 + vi00 (= tier bone-row index from caller).  Loop walks vi12
; iterations, mr32-rotating vf25/vf26 each time (lane-shift trick),
; then falls into LOOP_ROT_END for the perspective-divide path.
; -----------------------------------------------------------------------
INTERPOLATE:
	mulx.w vf25, vf17, vf30x         iadd vi12, vi00, vi07
	mulx.w vf26, vf21, vf30x         nop
	subw.xyzw vf25, vf17, vf25w      nop
	subw.xyzw vf26, vf21, vf26w      nop
	nop                              nop
LOOP_ROT:
	nop                              ibeq vi12, vi00, LOOP_ROT_END
	nop                              nop
	nop                              mr32.xyzw vf25, vf25
	nop                              mr32.xyzw vf26, vf26
	nop                              isubiu vi12, vi12, 1
	nop                              b LOOP_ROT
	nop                              nop

; -----------------------------------------------------------------------
; LOOP_ROT_END - perspective-divide + clip-test continuation.  Computes
; Q = vf25.x / vf27.x, |Q|, then mixes the per-axis differences by
; abs-Q to produce vf25/vf26/vf27 = vf17/vf18/vf19 + Q*(vfXX-vfYY).
; Bundle 0x27C8 is another flag-bits-set FMAC variant (`.word`).
; -----------------------------------------------------------------------
LOOP_ROT_END:
	sub.xyz vf27, vf26, vf25         nop
	nop                              div q, vf25x, vf27x
	addq.x vf29, vf00, q             waitq
	abs.x vf29, vf29                 nop
	sub.xyzw vf25, vf21, vf17        nop
	sub.xyzw vf26, vf22, vf18        nop
	sub.xyzw vf27, vf23, vf19        nop
	mulx.xyzw vf25, vf25, vf29x      nop
	mulx.xyzw vf26, vf26, vf29x      nop
	mulx.xyzw vf27, vf27, vf29x      nop
	add.xyzw vf25, vf25, vf17        nop
	add.xyzw vf26, vf26, vf18        nop
	add.xyzw vf27, vf27, vf19        nop
	nop                              jr vi01                                ; return to INTERPOLATE-call-site

; -----------------------------------------------------------------------
; sub_2818 (= sub_2818) - save-context vertex output subroutine.
;
; Called by SCISSOR_COMMON's `bal vi01, sub_2818`.  Builds a GIF packet via
; mem[vi02], applies matrix transform + perspective divide to vi03-
; stream vertices, ftoi-converts, stores via sq/sqi, then xgkicks the
; final packet.  Two xgkick stages: one with mem[8..11] matrix
; (initial), one with mem[16..19] matrix (post-transform).
; -----------------------------------------------------------------------
	nop                              nop                                    ; (entry - also delay slot from sub_2818 caller)
DrawScissorPolygon:
	nop                              iaddiu vi02, vi00, 37                  ; vi02 = mem[37] (GIF tag slot)
	nop                              iadd vi03, vi00, vi08                  ; vi03 = vi08 (input cursor)
	nop                              iaddiu vi07, vi02, 2                   ; vi07 = vi02 + 2 (output cursor)
	nop                              iaddiu vi11, vi00, 32767               ; vi11 = 0x7FFF
	nop                              iaddiu vi11, vi11, 1                   ; vi11 = 0x8000
	nop                              isw.x vi11, 0(vi02)                    ; mem[vi02].x = 0x8000 (count word)
	nop                              lq.xyzw vf01, 8(vi00)                  ; load matrix M0
	nop                              lq.xyzw vf02, 9(vi00)                  ; M1
	nop                              lq.xyzw vf03, 10(vi00)                 ; M2
	nop                              lq.xyzw vf04, 11(vi00)                 ; M3
	nop                              xgkick vi02                            ; kick initial GIF packet
	nop                              iaddiu vi11, vi10, 32767               ; vi11 = vi10 + 0x7FFF
	nop                              iaddiu vi11, vi11, 1                   ; vi11 = vi10 + 0x8000
	nop                              isw.x vi11, 0(vi02)                    ; mem[vi02].x = vi11 (count)

LOOP2:
	nop                              lq.xyzw vf20, 0(vi03)                  ; vf20 = *vi03 (input vertex)
	mulax.xyzw acc, vf01, vf20x      nop                                    ; ACC = vf01 * vf20.x
	madday.xyzw acc, vf02, vf20y     nop
	maddaz.xyzw acc, vf03, vf20z     nop
	maddw.xyzw vf25, vf04, vf20w     nop                                    ; vf25 = ACC + vf04*vf20.w
	nop                              div q, vf00w, vf25w                    ; Q = 1/vf25.w
	mulq.xyzw vf25, vf25, q          waitq                                  ; vf25 *= Q (perspective)
	ftoi4.xyzw  vf26, vf25           nop                                    ; vf26 = ftoi4(vf25)
	nop                              sq.xyzw vf26, 1(vi07)
	nop                              lq.xyzw vf20, 2(vi03)                  ; vf20 = mem[vi03+2]
	mulq.xyz vf28, vf20, q           nop                                    ; vf28 = vf20 * Q
	nop                              sq.xyzw vf28, -1(vi07)
	nop                              lq.xyzw vf27, 1(vi03)                  ; vf27 = mem[vi03+1]
	ftoi0.xyzw  vf29, vf27           nop                                    ; vf29 = ftoi0(vf27)
	nop                              sq.xyzw vf29, 0(vi07)
	nop                              iaddiu vi07, vi07, 3
	nop                              iaddiu vi03, vi03, 3
	nop                              iaddi vi10, vi10, -1
	nop                              nop
	nop                              ibne vi10, vi00, LOOP2
	nop                              nop                                    ; (branch delay slot)
	nop                              xgkick vi02                            ; kick transformed GIF packet
	nop                              lq.xyzw vf01, 16(vi00)                 ; reload matrix M0 from mem[16..19]
	nop                              lq.xyzw vf02, 17(vi00)
	nop                              lq.xyzw vf03, 18(vi00)
	nop                              lq.xyzw vf04, 19(vi00)
	nop                              nop
	nop                              jr vi01                                ; return to SCISSOR_COMMON caller
	nop                              nop                                    ; (delay slot)

; -----------------------------------------------------------------------
; SCISSOR_COMMON_PUSHREGISTER - VU0 register-bank save routine.
;
; Stores all 15 float registers vf17..vf31 (via sqd post-decrement
; into the vi14 stack), then packs all 14 int registers vi02..vi15
; into 4 quads via iswr (one lane per int).  Used as an interrupt
; save / context-switch primitive.  Caller saves vi14 (= "stack top")
; before calling; this routine returns via `jr vi15`.
; -----------------------------------------------------------------------
SCISSOR_COMMON_PUSHREGISTER:
	nop                              sqd.xyzw vf17, (--vi14)
	nop                              sqd.xyzw vf18, (--vi14)
	nop                              sqd.xyzw vf19, (--vi14)
	nop                              sqd.xyzw vf20, (--vi14)
	nop                              sqd.xyzw vf21, (--vi14)
	nop                              sqd.xyzw vf22, (--vi14)
	nop                              sqd.xyzw vf23, (--vi14)
	nop                              sqd.xyzw vf24, (--vi14)
	nop                              sqd.xyzw vf25, (--vi14)
	nop                              sqd.xyzw vf26, (--vi14)
	nop                              sqd.xyzw vf27, (--vi14)
	nop                              sqd.xyzw vf28, (--vi14)
	nop                              sqd.xyzw vf29, (--vi14)
	nop                              sqd.xyzw vf30, (--vi14)
	nop                              sqd.xyzw vf31, (--vi14)
	nop                              isubiu vi14, vi14, 1                   ; vi14--
	nop                              iswr.x vi02, (vi14)                    ; pack vi02..vi05 -> quad
	nop                              iswr.y vi03, (vi14)
	nop                              iswr.z vi04, (vi14)
	nop                              iswr.w vi05, (vi14)
	nop                              isubiu vi14, vi14, 1
	nop                              iswr.x vi06, (vi14)                    ; vi06..vi09 -> quad
	nop                              iswr.y vi07, (vi14)
	nop                              iswr.z vi08, (vi14)
	nop                              iswr.w vi09, (vi14)
	nop                              isubiu vi14, vi14, 1
	nop                              iswr.x vi10, (vi14)                    ; vi10..vi13 -> quad
	nop                              iswr.y vi11, (vi14)
	nop                              iswr.z vi12, (vi14)
	nop                              iswr.w vi13, (vi14)
	nop                              isubiu vi14, vi14, 1
	nop                              iswr.x vi14, (vi14)                    ; vi14, vi15 -> quad (vi00/vi01 omitted)
	nop                              iswr.y vi15, (vi14)
	nop                              nop
	nop                              jr vi15
	nop                              nop

; -----------------------------------------------------------------------
; SCISSOR_COMMON_POPREGISTER - VU0 register-bank restore routine.
;
; Reverses SCISSOR_COMMON_PUSHREGISTER: unpacks 4 int-saving quads via ilwr (one lane per
; int), then lqi 15 floats back into vf17..vf31 (in reverse order:
; vf31 first since save order is reverse).  Caller pre-loads vi14
; to the bottom-of-stack slot; routine returns via `jr vi01`.
; -----------------------------------------------------------------------
SCISSOR_COMMON_POPREGISTER:
	nop                              iadd vi01, vi00, vi15                  ; vi01 = vi15 (save return target)
	nop                              iswr.x vi14, (vi14)                    ; ?? (write-back vi14/vi15 first)
	nop                              iswr.y vi15, (vi14)
	nop                              iaddiu vi14, vi14, 1                   ; vi14++
	nop                              ilwr.x vi10, (vi14)                    ; unpack vi10..vi13 from quad
	nop                              ilwr.y vi11, (vi14)
	nop                              ilwr.z vi12, (vi14)
	nop                              ilwr.w vi13, (vi14)
	nop                              iaddiu vi14, vi14, 1
	nop                              ilwr.x vi06, (vi14)                    ; vi06..vi09
	nop                              ilwr.y vi07, (vi14)
	nop                              ilwr.z vi08, (vi14)
	nop                              ilwr.w vi09, (vi14)
	nop                              iaddiu vi14, vi14, 1
	nop                              ilwr.x vi02, (vi14)                    ; vi02..vi05
	nop                              ilwr.y vi03, (vi14)
	nop                              ilwr.z vi04, (vi14)
	nop                              ilwr.w vi05, (vi14)
	nop                              iaddiu vi14, vi14, 1
	nop                              lqi.xyzw vf31, (vi14++)                ; restore vf17..vf31 (reverse)
	nop                              lqi.xyzw vf30, (vi14++)
	nop                              lqi.xyzw vf29, (vi14++)
	nop                              lqi.xyzw vf28, (vi14++)
	nop                              lqi.xyzw vf27, (vi14++)
	nop                              lqi.xyzw vf26, (vi14++)
	nop                              lqi.xyzw vf25, (vi14++)
	nop                              lqi.xyzw vf24, (vi14++)
	nop                              lqi.xyzw vf23, (vi14++)
	nop                              lqi.xyzw vf22, (vi14++)
	nop                              lqi.xyzw vf21, (vi14++)
	nop                              lqi.xyzw vf20, (vi14++)
	nop                              lqi.xyzw vf19, (vi14++)
	nop                              lqi.xyzw vf18, (vi14++)
	nop                              lqi.xyzw vf17, (vi14++)
	nop                              nop

; -----------------------------------------------------------------------
; sub_2BB0 - `jr vi01` return stub.  Reachable as a dispatch-table
; entry (TPC=0xE0 -> b sub_2BB0 in program 3's table) and as a fall-
; through from SCISSOR_COMMON_POPREGISTER's context-restore tail.
; -----------------------------------------------------------------------
	nop                              jr vi01
	nop                              nop

; -----------------------------------------------------------------------
; sub_2BC0 - vertex-buffer init / clear.  Sets up vf17/vf31 to known
; values, loads working matrix from mem[20..23], and initializes
; vi14 = 256 (heap base).  Terminates via E-bit.
; -----------------------------------------------------------------------
BEGIN_SCISSOR_C:
	sub.xyzw vf31, vf00, vf00        lq.xyzw vf17, 2(vi00)                  ; vf31 = 0; vf17 = mem[2]
	nop                              lq.xyzw vf13, 20(vi00)
	nop                              lq.xyzw vf14, 21(vi00)
	nop                              lq.xyzw vf15, 22(vi00)
	nop                              lq.xyzw vf16, 23(vi00)
	mulw.w vf17, vf00, vf00w         iaddiu vi14, vi00, 256
	nop                              move.z vf17, vf00                      ; vf17.z = 0
	nop[e]                           nop                                    ; upper: E-bit pad (END)

; -----------------------------------------------------------------------
; sub_2C00 - bone-blended vertex transform with clip-flag culling.
;
; Reads vi01 (VIF top), masks count in vi10, output base vi02 = vi01
; + 192.  Per-vertex loop blends two bones (vf18/vf21/vf20 source +
; vf04/vf03 dest), perspective-divides, ftoi4-converts, and stores
; one of two output paths based on clip-flag testing via fcand /
; fcor against a sequence of magic bit-masks at 0x2DB0..0x2E30.
;
; The clip-mask sequence (0xFDF7DF, 0xFEFBEF, 0xFF7DF7, 0xFFBEFB,
; 0xFFDF7D, 0xFFEFBE) progressively excludes one clip plane per
; iteration; if any of them indicate a fully-visible vertex (ibne
; fires), control falls into the L_1690 path which `bal vi15`s to
; the SCISSOR_COMMON_PUSHREGISTER save-context, L_08D8 hierarchical-driver, and SCISSOR_COMMON_POPREGISTER
; restore-context routines in sequence (effectively recursing into
; the LOD subdivider for that vertex), then `b SCISSOR_C_XYZ2` continues
; the per-vertex loop.  Otherwise (no fall-through), branches to
; SCISSOR_C_XYZ2 directly.
;
; Output kick: `xgkick vi02` + `b BEGIN_SCISSOR_C` returns to the init stub's
; E-bit at 0x2BF8.
;
; Bundles 0x2CD8, 0x2CE0, 0x2CF0 are flag-bits-set FMACs (FD-dispatch
; .xyz variants) emitted via `.word`.
; -----------------------------------------------------------------------
	nop                              nop                                    ; (entry - also E-bit delay slot of BEGIN_SCISSOR_C)
START_SCISSOR_C:
	nop                              xtop vi01                              ; vi01 = VIF top
	nop                              ilwr.x vi10, (vi01)                    ; vi10 = *(int*)vi01 (count)
	nop                              iaddiu vi11, vi00, 32767               ; vi11 = 0x7FFF
	nop                              iand vi10, vi10, vi11                  ; vi10 &= 0x7FFF
	nop                              iaddi vi11, vi11, 1                    ; vi11 = 0x8000
	nop                              lq.xyzw vf25, 0(vi01)                  ; vf25 = mem[vi01] (header quad)
	nop                              iaddiu vi03, vi01, 1                   ; vi03 = vi01 + 1 (input cursor)
	nop                              iaddiu vi02, vi01, 192                 ; vi02 = vi01 + 192 (output base)
	nop                              sq.xyzw vf25, 0(vi02)                  ; store header
	nop                              iaddiu vi07, vi02, 1                   ; vi07 = vi02 + 1 (output cursor)
	mulw.xyzw vf22, vf00, vf00w      iaddi vi04, vi00, -2                   ; vf22 = 0; vi04 = -2
	mulw.xyzw vf23, vf00, vf00w      iaddi vi05, vi00, -2                   ; vf23 = 0; vi05 = -2
	mulw.xyzw vf24, vf00, vf00w      iaddi vi06, vi00, -2                   ; vf24 = 0; vi06 = -2
	nop                              lq.xyzw vf18, 0(vi03)                  ; preload vf18
	nop                              lq.xyzw vf21, 1(vi03)                  ; preload vf21
	nop                              lq.xyzw vf20, 2(vi03)                  ; preload vf20
	nop                              nop

SCISSOR_C_LOOP:
	mulax.xyzw acc, vf01, vf18x      move.xyzw vf22, vf23
	madday.xyzw acc, vf02, vf18y     move.xyzw vf23, vf24
	maddaz.xyzw acc, vf03, vf18z     iaddiu vi03, vi03, 3
	maddw.xyzw vf25, vf04, vf18w     iaddi vi10, vi10, -1
	sub.w       vf00, vf21, vf00     iadd vi04, vi00, vi05
	mulax.xyzw acc, vf13, vf18x      iadd vi05, vi00, vi06
	madday.xyzw acc, vf14, vf18y     nop
	maddaz.xyzw acc, vf15, vf18z     div q, vf00w, vf25w
	maddw.xyzw vf24, vf16, vf18w     fsand vi08, 0x2
	clipw.xyz vf22, vf22w            lq.xyzw vf18, 0(vi03)                  ; upper: op6=0x3F .xyz fd=7 fs=22 ft=22
	clipw.xyz vf23, vf23w            nop                                    ; upper: op6=0x3F .xyz fd=7 fs=23 ft=23
	add.xyz     vf28, vf21, vf17     nop
	clipw.xyz vf24, vf24w            lq.xyzw vf21, 1(vi03)                  ; upper: op6=0x3F .xyz fd=7 fs=24 ft=24
	ftoi0.xyzw  vf29, vf20           nop
	mulq.xyzw vf27, vf25, q          lq.xyzw vf20, 2(vi03)
	mulq.xyz vf28, vf28, q           nop
	nop                              fcand vi01, 0x3F                       ; vi01 = clip-flag bits 0..5
	nop                              sq.xyzw vf29, 1(vi07)                  ; store vf29
	ftoi4.xyzw  vf27, vf27           ibeq vi08, vi00, SCISSOR_C_CONT
	nop                              iadd vi06, vi00, vi01                  ; (delay slot) vi06 = clip bits
	nop                              iaddi vi04, vi00, 1
	nop                              iaddi vi05, vi00, 1
	nop                              iaddi vi09, vi00, 2
SCISSOR_C_CONT:
	nop                              iadd vi01, vi04, vi05
	nop                              iadd vi01, vi01, vi06
	nop                              sq.xyzw vf28, 0(vi07)
	nop                              ibgtz vi01, SCISSOR_C_XYZ3
	nop                              sq.xyzw vf27, 2(vi07)                  ; (delay slot)
SCISSOR_C_XYZ2:
	nop                              ibne vi10, vi00, SCISSOR_C_LOOP        ; loop while count != 0
	nop                              iaddiu vi07, vi07, 3                   ; (delay slot)
	nop                              xgkick vi02                            ; kick GIF packet
	nop                              nop
	nop                              b BEGIN_SCISSOR_C                      ; -> sub_2BC0's E-bit
	nop                              nop                                    ; (branch delay slot)
SCISSOR_C_XYZ3:
	nop                              iaddi vi09, vi09, -1
	nop                              ibgtz vi09, SCISSOR_C_XYZ3_ONLY
	nop                              fcor vi01, 0xFDF7DF
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFEFBEF
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFF7DF7
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFFBEFB
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFFDF7D
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFFEFBE
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              bal vi15, SCISSOR_COMMON_PUSHREGISTER  ; save context
	nop                              nop
	nop                              bal vi15, SCISSOR_COMMON                       ; call LOD hierarchical driver
	nop                              nop
	nop                              bal vi15, SCISSOR_COMMON_POPREGISTER   ; restore context
	nop                              nop
SCISSOR_C_XYZ3_ONLY:
	nop                              b SCISSOR_C_XYZ2                       ; back into the per-vertex loop
	nop                              isw.w vi11, 2(vi07)                    ; (delay slot - also stores vi11.w)

; =======================================================================
; FOURTH VU0 PROGRAM begins here.  Same multi-program concatenation
; pattern as the program-1/2/3 transitions.  FCSET imm this time is
; 0x1C8.  Followed by an entry-stub table at 0x2EA0..0x2FD8 and the
; program-4 routine bodies starting at L_1830.
; =======================================================================

; Program-4 control-flag prologue (parallels 0x0000..0x0008 / 0x0DB0
; / 0x17A0 in earlier programs).
	.EndMPG
	.EndDmaData
	DMAend
